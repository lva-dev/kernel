# Bytes per word
UNITS_PER_WORD 4

# Primitive sizes
CHAR_TYPE_SIZE      := 8
SHORT_TYPE_SIZE     := 16
INT_TYPE_SIZE       := 32
LONG_TYPE_SIZE      := 64
LONG_LONG_TYPE_SIZE := 64
DEFAULT_SIGNED_CHAR := 0

# Types
SIZE_TYPE           := unsigned long
PTRDIFF_TYPE        := signed long 
INTMAX_TYPE         := signed long long
UINTMAX_TYPE        := unsigned long long
INT8_TYPE           := signed char
INT16_TYPE          := signed short
INT32_TYPE          := signed int
INT64_TYPE          := signed long
UINT8_TYPE          := unsigned char
UINT16_TYPE         := unsigned short
UINT32_TYPE         := unsigned int
UINT64_TYPE         := unsigned long
INT_LEAST8_TYPE     := INT8_TYPE
INT_LEAST16_TYPE    := INT16_TYPE
INT_LEAST32_TYPE    := INT32_TYPE
INT_LEAST64_TYPE    := INT64_TYPE
UINT_LEAST8_TYPE    := UINT8_TYPE
UINT_LEAST16_TYPE   := UINT16_TYPE
UINT_LEAST32_TYPE   := UINT32_TYPE
UINT_LEAST64_TYPE   := UINT64_TYPE
INT_FAST8_TYPE      := INT8_TYPE
INT_FAST16_TYPE     := INT16_TYPE
INT_FAST32_TYPE     := INT32_TYPE
INT_FAST64_TYPE     := INT64_TYPE
UINT_FAST8_TYPE     := UINT8_TYPE
UINT_FAST16_TYPE    := UINT16_TYPE
UINT_FAST32_TYPE    := UINT32_TYPE
UINT_FAST64_TYPE    := UINT64_TYPE
INTPTR_TYPE         := INT64_TYPE
UINTPTR_TYPE        := UINT64_TYPE

STORAGE_LAYOUT += UNITS_PER_WORD \
 CHAR_TYPE_SIZE \
 SHORT_TYPE_SIZE \
 INT_TYPE_SIZE \
 LONG_TYPE_SIZE \
 LONG_LONG_TYPE_SIZE \
 DEFAULT_SIGNED_CHAR \
 SIZE_TYPE \
 PTRDIFF_TYPE \
 INTMAX_TYPE \
 UINTMAX_TYPE \
 INT8_TYPE \
 INT16_TYPE \
 INT32_TYPE \
 INT64_TYPE \
 UINT8_TYPE \
 UINT16_TYPE \
 UINT32_TYPE \
 UINT64_TYPE \
 INT_LEAST8_TYPE \
 INT_LEAST16_TYPE \
 INT_LEAST32_TYPE \
 INT_LEAST64_TYPE \
 UINT_LEAST8_TYPE \
 UINT_LEAST16_TYPE \
 UINT_LEAST32_TYPE \
 UINT_LEAST64_TYPE \
 INT_FAST8_TYPE \
 INT_FAST16_TYPE \
 INT_FAST32_TYPE \
 INT_FAST64_TYPE \
 UINT_FAST8_TYPE \
 UINT_FAST16_TYPE \
 UINT_FAST32_TYPE \
 UINT_FAST64_TYPE \
 INTPTR_TYPE \
 UINTPTR_TYPE